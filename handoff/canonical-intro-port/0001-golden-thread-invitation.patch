+/**
+ * Deterministic choreography for the golden-thread brand intro.
+ *
+ * Ported from the Next.js Basma app (its splash state machine) into this app's
+ * plain-JavaScript conventions, so the component only renders a phase while
+ * this module decides what may follow what.
+ *
+ * One continuous story: a single golden thread draws the theatrical mask, then
+ * the scales of justice, then converges into the approved logo before the
+ * bilingual invitation appears and waits for a human.
+ */
+
+export const INTRO_PHASES = ["THREAD", "MASK", "SCALES", "LOGO", "INVITATION", "COMPLETE"];
+
+/** Which drawing stage the SVG shows (monotonic; used for cumulative reveals). */
+export const INTRO_STAGE = {
+  THREAD: 1,
+  MASK: 2,
+  SCALES: 3,
+  LOGO: 4,
+  INVITATION: 5,
+  COMPLETE: 6,
+};
+
+/** How long each automatic phase holds before advancing. */
+export const INTRO_HOLD_MS = {
+  THREAD: 1500,
+  MASK: 1400,
+  SCALES: 1400,
+  LOGO: 1200,
+};
+
+/** The invitation waits for a human, so it has no automatic advance. */
+export const INTRO_AUTO_CHAIN = ["THREAD", "MASK", "SCALES", "LOGO", "INVITATION"];
+
+export const INTRO_SEEN_KEY = "bm-intro-seen";
+
+/** The next automatic phase, or null when the intro waits for the visitor. */
+export function nextIntroPhase(phase) {
+  const index = INTRO_AUTO_CHAIN.indexOf(phase);
+  if (index === -1) return null;
+  return INTRO_AUTO_CHAIN[index + 1] ?? null;
+}
+
+/** Auto-advance delay for a phase, or null when it waits on the visitor. */
+export function introHoldDelay(phase) {
+  return INTRO_HOLD_MS[phase] ?? null;
+}
+
+/**
+ * Reduced motion still gets the brand moment and the invitation - it just does
+ * not animate into them. A returning visitor inside the same session skips it.
+ */
+export function initialIntroPhase({ reducedMotion }) {
+  return reducedMotion ? "INVITATION" : "THREAD";
+}
+
+export function shouldPlayIntro({ seen, replayRequested }) {
+  if (replayRequested) return true;
+  return !seen;
+}
