# Canonical public origin used for metadata, hreflang and sitemap.
NEXT_PUBLIC_SITE_URL=https://basma-moussa.example.com

# Basma AI Studio. Never commit real values, do not use NEXT_PUBLIC_ for secrets.
# Without these, the API honestly returns 503 (not configured).
AI_API_KEY=
AI_MODEL=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_APPROVED_PROVIDER_HOSTS=api.openai.com

# Required for production traffic; distributed fail-closed rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_RATE_LIMIT_SALT=
