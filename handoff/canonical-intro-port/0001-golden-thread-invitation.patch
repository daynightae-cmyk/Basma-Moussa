+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+  INTRO_AUTO_CHAIN,
+  INTRO_HOLD_MS,
+  INTRO_PHASES,
+  INTRO_STAGE,
+  initialIntroPhase,
+  introHoldDelay,
+  nextIntroPhase,
+  shouldPlayIntro,
+} from "../src/lib/experience/intro-sequence.js";
+
+test("every phase has a drawing stage and the reveal never goes backwards", () => {
+  assert.deepEqual(Object.keys(INTRO_STAGE), INTRO_PHASES);
+  const stages = INTRO_PHASES.map((phase) => INTRO_STAGE[phase]);
+  assert.deepEqual(stages, [...stages].sort((a, b) => a - b));
+});
+
+test("the automatic chain advances one phase at a time and stops at the invitation", () => {
+  for (let i = 0; i < INTRO_AUTO_CHAIN.length - 1; i += 1) {
+    assert.equal(nextIntroPhase(INTRO_AUTO_CHAIN[i]), INTRO_AUTO_CHAIN[i + 1]);
+  }
+  assert.equal(nextIntroPhase("INVITATION"), null);
+  assert.equal(nextIntroPhase("COMPLETE"), null);
+});
+
+test("only drawing phases hold a timer; the invitation waits for a human", () => {
+  for (const phase of INTRO_AUTO_CHAIN.slice(0, -1)) {
+    assert.ok(INTRO_HOLD_MS[phase] > 0, phase);
+    assert.equal(introHoldDelay(phase), INTRO_HOLD_MS[phase]);
+  }
+  assert.equal(introHoldDelay("INVITATION"), null);
+  assert.equal(introHoldDelay("COMPLETE"), null);
+});
+
+test("reduced motion opens on the invitation instead of the animated thread", () => {
+  assert.equal(initialIntroPhase({ reducedMotion: true }), "INVITATION");
+  assert.equal(initialIntroPhase({ reducedMotion: false }), "THREAD");
+});
+
+test("a returning visitor skips the intro unless a replay was requested", () => {
+  assert.equal(shouldPlayIntro({ seen: true, replayRequested: false }), false);
+  assert.equal(shouldPlayIntro({ seen: true, replayRequested: true }), true);
+  assert.equal(shouldPlayIntro({ seen: false, replayRequested: false }), true);
+});
